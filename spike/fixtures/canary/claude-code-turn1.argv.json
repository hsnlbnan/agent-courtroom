{
  "cmd": "claude",
  "args": [
    "-p",
    "Sen konseyde şüpheci üyesin. Çalışma klasöründeki dosyaları (idea.md, README.md, src/) oku ve fikri değerlendir, en fazla 100 kelime.",
    "--output-format",
    "stream-json",
    "--verbose",
    "--restricted",
